# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The previous version of this project had a working Gmail app password
# hardcoded in backend/refresh_scraper.py. Everything secret now lives here.

ENVIRONMENT=development
DEBUG=true

# --- Security -------------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left unset, a random secret is generated per process, so every restart
# invalidates all tokens and multiple replicas disagree with each other.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=720

# --- Storage --------------------------------------------------------------
DATABASE_URL=sqlite:///./data/tracker.db
ARTIFACT_DIR=./ml/artifacts

# --- CORS -----------------------------------------------------------------
# Comma separated. Must list the deployed frontend origin. Never use "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Live collection --------------------------------------------------------
# Scrape the pages in collector/targets.json every N minutes inside the API.
# 0 = off. 240 (four hours) is plenty for daily-level forecasting.
COLLECT_INTERVAL_MINUTES=0
# Retrain the forecasters every N hours. 0 = off. Training switches from the
# synthetic bootstrap data to live data once every series has
# MIN_TRAINING_DAYS of history.
RETRAIN_INTERVAL_HOURS=0
MIN_TRAINING_DAYS=60
# Seconds between requests to the same retailer.
SCRAPE_DELAY_SECONDS=4.0
RESPECT_ROBOTS=true
# Identify your collector honestly. Retailers may block automated clients;
# check each site's terms before collecting.
SCRAPE_USER_AGENT=CompetitorTracker/2.0 (+https://github.com/<you>/<repo>)
# Lets an external collector (the GitHub Actions workflow) push readings to
# POST /api/collect/ingest. At least 24 characters. Unset = endpoint disabled.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
COLLECTOR_TOKEN=

# --- Optional: LLM narration ----------------------------------------------
# Only rewrites computed figures as prose. It never produces a price.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Optional: email alerts -----------------------------------------------
# Use an app password, never your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENTS=
